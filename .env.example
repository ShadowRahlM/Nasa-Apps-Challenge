DATABASE_URL=postgres://agrismart:local_dev_password@localhost:5432/agrismart?sslmode=disable
ADDR=:8080
# Chat assistant (create a key at https://console.groq.com/keys).
# Set GROQ_API_KEY in the server's environment; never commit a real key.
GROQ_API_KEY=your-groq-api-key
# Optional: choose an active model from https://console.groq.com/docs/models.
GROQ_MODEL=qwen/qwen3.8-27b
# Optional forecast provider. Without these, the free Open-Meteo forecast is used.
# METEOMATICS_USER=
# METEOMATICS_PASSWORD=
